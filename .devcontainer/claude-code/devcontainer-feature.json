{
  "id": "claude-code",
  "version": "1.0.0",
  "name": "Claude Code",
  "installsAfter": ["ghcr.io/devcontainers/features/common-utils:1"],
  "mounts": [
    {
      "type": "volume",
      "source": "claude",
      "target": "/home/node/.claude"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code"]
    }
  }
}
